# Copy this file to .env and fill in your values. Never commit .env.

# GitHub — a token with repo read access (gh auth token, or a PAT)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Jira Cloud — your site, the email of the account, and an API token
# (id.atlassian.com -> Security -> API tokens)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=SCRUM

# Azure OpenAI — from your Azure OpenAI resource (Keys and Endpoint + a deployment)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Slack — an Incoming Webhook URL
SLACK_WEBHOOK_URL=
